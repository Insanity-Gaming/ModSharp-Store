<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Target -->
        <TargetFramework>net10.0</TargetFramework>

        <!-- Names -->
        <AssemblyName>Store</AssemblyName>
        <RootNamespace>InsanityGaming.Store</RootNamespace>

        <!-- Language / Quality -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>

        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>

        <!-- Build -->
        <Optimize>true</Optimize>
        <Deterministic>true</Deterministic>

        <!-- Versioning (plays nice with your CI) -->
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>

        <!-- Output -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

        <!-- Trimming / runtime safety -->
        <PublishTrimmed>false</PublishTrimmed> <!-- DO NOT trim for ModSharp -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Nullable warnings stricter (optional but good) -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModSharp.Sharp.Modules.AdminManager.Shared" Version="2.1.189" />
        <PackageReference Include="ModSharp.Sharp.Modules.ClientPreferences.Shared" Version="2.1.189" />
        <PackageReference Include="ModSharp.Sharp.Modules.TargetingManager.Shared" Version="2.1.189" />
        <PackageReference Include="ModSharp.Sharp.Shared" Version="2.1.189" PrivateAssets="all" />
        <PackageReference Include="SqlSugarCore" Version="5.1.4.214" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Store.Shared\Store.Shared.csproj" />
      <!-- HudArbiter's API from the private Insanity-Gaming feed (see nuget.config). Loaded from
           game/sharp/shared at runtime, so it is compile-only and never shipped with this module. -->
      <PackageReference Include="InsanityGaming.HudArbiter.Shared" Version="1.0.2" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>