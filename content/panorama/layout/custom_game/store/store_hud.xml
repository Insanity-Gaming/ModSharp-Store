<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/store/store_hud.css" />
	</styles>

	<!-- Unnamed outer panel: the outermost panel under <root> must not have an id. -->
	<Panel class="StoreHudRoot" hittest="false">
		<Panel id="store_root" class="StoreRoot" hittest="false">

			<!-- Top bar: logo, Buy / Equip / Settings, credits, close -->
			<Panel class="TopBar">
				<Image class="Logo" hittest="false" src="file://{images}/custom_game/store/ig_logo.png" />
				<Label class="Brand" hittest="false" text="STORE" />
				<Panel class="Tabs" hittest="false">
					<Button id="tab_buy" class="Tab"><Label class="TabLabel" hittest="false" text="BUY ITEMS" /></Button>
					<Button id="tab_equip" class="Tab"><Label class="TabLabel" hittest="false" text="EQUIP ITEMS" /></Button>
					<Button id="tab_settings" class="Tab"><Label class="TabLabel" hittest="false" text="SETTINGS" /></Button>
				</Panel>
				<Panel class="TopBarSpacer" hittest="false" />
				<Panel class="Credits" hittest="false"><Label id="credits_lbl" class="CreditsLabel" hittest="false" text="{s:value}" /></Panel>
				<Button id="close" class="CloseButton"><Label class="CloseLabel" hittest="false" text="✕" /></Button>
			</Panel>

			<Panel class="Body" hittest="false">

				<!-- Shop (Buy / Equip): collapsible category sections | preview model | detail.
				     Panorama can't reorder panels, so the open section's header and those before it
				     use the sec_ slots above the rows and the rest use the secb_ slots below them. -->
