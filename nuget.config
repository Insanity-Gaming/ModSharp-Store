<?xml version="1.0" encoding="utf-8"?>
<!--
  InsanityGaming.* packages (e.g. InsanityGaming.HudArbiter.Shared) come from the org's private GitHub
  Packages feed; everything else from nuget.org. Credentials are read from environment variables:
    GITHUB_PACKAGES_USER   your GitHub username (CI: github.actor)
    GITHUB_PACKAGES_TOKEN  a token with read:packages (CI: secrets.GITHUB_TOKEN)
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="insanity-gaming" value="https://nuget.pkg.github.com/Insanity-Gaming/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="insanity-gaming">
      <package pattern="InsanityGaming.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <insanity-gaming>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </insanity-gaming>
  </packageSourceCredentials>
</configuration>
