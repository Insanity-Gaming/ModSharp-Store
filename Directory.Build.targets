<Project>

  <Target Name="CopyPluginOutput" AfterTargets="Build">

    <PropertyGroup>
      <!-- Repo-root game folder, anchored to where this file lives -->
      <_GameRoot>$(MSBuildThisFileDirectory)game/</_GameRoot>

      <!--
        Store.Shared  → game/sharp/shared/InsanityGaming.Store.Shared/
        All others    → game/sharp/modules/<last-segment-lower>/  e.g. store
      -->
      <PluginOutput Condition="$(AssemblyName.Contains('Shared'))">$(_GameRoot)sharp/shared/$(AssemblyName)/</PluginOutput>
      <_ModuleName>$([System.Text.RegularExpressions.Regex]::Match($(AssemblyName), '[^.]+$').Value.ToLower())</_ModuleName>
      <PluginOutput Condition="!$(AssemblyName.Contains('Shared'))">$(_GameRoot)sharp/modules/$(_ModuleName)/</PluginOutput>
    </PropertyGroup>

    <MakeDir Directories="$(PluginOutput)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).deps.json" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <Copy
      SourceFiles="@(PluginFiles)"
      DestinationFolder="$(PluginOutput)"
      SkipUnchangedFiles="true" />

    <!-- Gamedata copy only applies to the main plugin, not shared libraries -->
    <ItemGroup Condition="!$(AssemblyName.Contains('Shared'))">
      <GameDataFiles Include="$(MSBuildProjectDirectory)/gamedata/**/*" />
    </ItemGroup>

    <MakeDir Directories="$(_GameRoot)sharp/gamedata" Condition="!$(AssemblyName.Contains('Shared'))" />

    <Copy
      Condition="!$(AssemblyName.Contains('Shared'))"
      SourceFiles="@(GameDataFiles)"
      DestinationFolder="$(_GameRoot)sharp/gamedata/%(RecursiveDir)"
      SkipUnchangedFiles="true" />

  </Target>

</Project>
